# --- IA ---
AI_PROVIDER=template
AI_MODEL=template-v1
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# OPENAI_API_KEY=

# --- Voz ---
# mock | macos-say | openai-tts | elevenlabs | file | chatterbox
#
# Natural (recomendado): openai-tts  → necesita OPENAI_API_KEY
# Tu voz grabada:        file        → output/<id>/narration.custom.wav
# Clonar tu voz:         elevenlabs  → ELEVENLABS_* + npm run short:clone-voice
# Sistema (robótica):    macos-say
# Local Chatterbox:      chatterbox  → Python CLI + pesos + ref locales (fase 2A)
#
VOICE_PROVIDER=openai-tts
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_NAME=coral
# Velocidad TTS 0.25–4 (1.0=normal; Shorts ~1.2–1.3)
VOICE_SPEED=1.25
# Instrucciones largas: mejor en archivo
# VOICE_INSTRUCTIONS_FILE=data/voices/instructions-andaluz.txt
# VOICE_INSTRUCTIONS=Habla en español de España, natural y dinámico…
# VOICE_API_KEY=

# ElevenLabs (clon)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Archivo propio (VOICE_PROVIDER=file · solo WAV PCM)
# VOICE_FILE=data/voices/me.wav

# macOS say (solo si no hay API)
# VOICE_PROVIDER=macos-say
# VOICE_MODEL=Flo (Español (España))

# Chatterbox (local · VoiceProvider fase 2A · sin pesos/ref en Git)
# Requiere venv Python 3.11 + pins de tools/chatterbox/requirements-pin.txt
# y el pack es-es descargado fuera del repo. Ver tools/chatterbox/README.md.
# VOICE_PROVIDER=chatterbox
# CHATTERBOX_PYTHON=/path/to/chatterbox-venv/bin/python
# CHATTERBOX_SCRIPT=tools/chatterbox/synthesize.py
# CHATTERBOX_CKPT_DIR=/path/to/local/es-es-checkpoints
# CHATTERBOX_REF_WAV=/path/to/local/ref.wav
# CHATTERBOX_DEVICE=auto
# CHATTERBOX_TIMEOUT_MS=300000
# CHATTERBOX_LANGUAGE_ID=es
# CHATTERBOX_EXAGGERATION=0.5
# CHATTERBOX_CFG_WEIGHT=0.5
# CHATTERBOX_TEMPERATURE=0.8

# --- Vídeo ---
SHORTS_LANGUAGE=es
SHORTS_TARGET_DURATION=25
SHORTS_MAX_DURATION=45
SHORTS_MIN_DURATION=12
SHORTS_FPS=30
SHORTS_WIDTH=1080
SHORTS_HEIGHT=1920
SHORTS_OUTPUT_DIR=output
SHORTS_PREVIEW_SCALE=0.5

# --- Pipeline ---
SHORTS_MAX_RETRIES=2
SHORTS_REQUEST_TIMEOUT_MS=60000
SHORTS_HUMAN_REVIEW_POLICY=warn_and_continue
