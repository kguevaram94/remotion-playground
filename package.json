    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "short": "tsx src/cli/short.ts",
    "generar-short": "bash scripts/generar-short.sh",
    "short:script": "tsx src/cli/short.ts --mode script",
    "short:render": "tsx src/cli/short.ts --mode render",
    "short:preview": "tsx src/cli/short.ts --mode preview",
    "short:studio-props": "tsx src/cli/studio-props.ts",
    "short:resume": "tsx src/cli/short.ts --mode resume",
    "short:validate": "tsx src/cli/short.ts --mode validate",
    "short:voice": "tsx src/cli/short.ts --mode voice",
    "short:voices": "tsx src/cli/short.ts --mode voices",
    "short:post": "tsx src/cli/short.ts --mode post",
    "short:record": "tsx src/cli/record-voice.ts",
    "short:clone-voice": "tsx src/cli/clone-voice.ts",
    "short:preview-voices": "tsx src/cli/preview-openai-voices.ts",
    "sfx:generate": "node scripts/generate-sfx.mjs"
  }
