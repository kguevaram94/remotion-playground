    "@remotion/media-utils": "^4.0.535",
    "@remotion/paths": "^4.0.535",
    "@remotion/transitions": "^4.0.535",
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^15.0.0",
    "dotenv": "^18.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-peeps": "^0.1.10",
    "remotion": "4.0.535",
    "satori": "^0.62.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.535",
    "@remotion/eslint-config-flat": "4.0.535",
    "@remotion/media-parser": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "@types/node": "^26.6.5",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
